# GitHub Personal Access Token (needs `repo` scope for private repos or `public_repo` for public PRs)
GITHUB_TOKEN=ghp_your_token_here

# LLM Provider: openai | anthropic | demo
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Provider API keys (only the active provider's key is required)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Sandbox backend: docker | local
SANDBOX_BACKEND=docker
DOCKER_IMAGE=issue-to-pr-sandbox:latest

# Agent loop budgets
MAX_REPRO_ATTEMPTS=2
MAX_FIX_ATTEMPTS=4
DRY_RUN=false
